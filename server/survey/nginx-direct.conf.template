limit_req_zone $binary_remote_addr zone=tvt_per_ip:1m rate=1r/s;
limit_req_zone $server_name zone=tvt_total:1m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=tvt_connections:1m;
limit_conn_zone $server_name zone=tvt_global_connections:1m;

server {
    listen 80 default_server;
    server_name PUBLIC_IP;
    access_log off;
    server_tokens off;
    client_max_body_size 8k;
    client_header_timeout 5s;
    client_body_timeout 5s;
    keepalive_timeout 5s;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/tvt-acme;
        default_type text/plain;
        limit_except GET { deny all; }
        try_files $uri =404;
    }
    location / { return 404; }
}

server {
    listen 443 ssl default_server;
    server_name PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/tvt-survey-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tvt-survey-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:TvTSurveyTLS:1m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    access_log off;
    server_tokens off;
    client_max_body_size 8k;
    client_body_buffer_size 8k;
    client_header_timeout 5s;
    client_body_timeout 5s;
    keepalive_timeout 5s;
    send_timeout 10s;
    limit_conn tvt_connections 4;
    limit_conn tvt_global_connections 128;
    limit_conn_status 429;
    limit_req_status 429;
    if ($host != "PUBLIC_IP") { return 444; }

    location = /api/feedback {
        if ($request_method != POST) { return 405; }
        limit_req zone=tvt_per_ip burst=3 nodelay;
        limit_req zone=tvt_total burst=20 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host "PUBLIC_IP";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
        proxy_send_timeout 10s;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
    }
    location / { return 404; }
}
